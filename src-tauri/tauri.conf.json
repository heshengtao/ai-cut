{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Cut",
  "version": "1.0.0",
  "identifier": "com.aicut.editor",
  "build": {
    "beforeDevCommand": "npm run fetch:ort && npm run fetch:sidecars && npm run build:aicut && npm run dev",
    "devUrl": "http://localhost:28430",
    "beforeBuildCommand": "npm run fetch:ort && npm run sync:ofx && npm run build && npm run fetch:sidecars && npm run build:aicut",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Cut",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "maximized": true,
        "create": false,
        "visible": false,
        "backgroundColor": "#1c1b1f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/aicut"
    ],
    "resources": {
      "resources/models/": "models/",
      "resources/ort/": "ort/",
      "../dist/": "dist/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/data-dir-hook.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNzNCNDg1MDE1NjFEMzkKUldRNUhWWUJoYlJ6ZS82eUh3YXFZcDkxZUZ6eWxXY3JvMlNvUzh2VlVJaEU1aWhKRmtYVW5yM0IK",
      "endpoints": [
        "https://github.com/heshengtao/ai-cut/releases/latest/download/latest.json"
      ]
    }
  }
}
